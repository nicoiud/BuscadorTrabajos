# App
ENVIRONMENT=development
SECRET_KEY=change-me
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://buscador:buscador@localhost:5432/buscador

# AI providers (Fase 2: enrichment + búsqueda semántica)
#
# LLM_* configura el modelo de chat/completions (extracción de avisos, carta de
# presentación, respuestas de autofill) contra cualquier endpoint compatible con la
# API de OpenAI — no hace falta tocar código para cambiar de proveedor, solo estas
# tres variables. Sin API key configurada, todo lo demás (ingestion, búsqueda por
# keyword) sigue funcionando igual; solo fallan los endpoints que llaman al modelo.
#
# Groq (gratis, rápido):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
#
# NVIDIA API Catalog (alternativa gratuita, descomentar y usar en vez de Groq):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct

# EMBEDDING_* configura los embeddings para búsqueda semántica, mismo patrón que
# LLM_* — cualquier endpoint compatible con la API de embeddings de OpenAI. Default
# apunta a Ollama local (gratis). Requiere correr `ollama pull mxbai-embed-large`
# antes de usar la búsqueda con IA.
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=mxbai-embed-large
ENRICHMENT_BATCH_SIZE=20

# Empresas a agregar vía las APIs públicas de Greenhouse/Lever (una por cada empresa
# que use esa plataforma como ATS), separadas por coma. El slug es el que aparece en
# la URL pública del board de esa empresa. Ej:
# GREENHOUSE_BOARDS=stripe,notion,airbnb
# LEVER_COMPANIES=netflix,figma
GREENHOUSE_BOARDS=
LEVER_COMPANIES=

# Feeds RSS de We Work Remotely, separados por coma. Default: solo la categoría de
# programación (única URL verificada). Más categorías en
# https://weworkremotely.com/categories/<categoria>.rss
WEWORKREMOTELY_FEED_URLS=https://weworkremotely.com/categories/remote-programming-jobs.rss

# Job source APIs (used from Phase 5 onward)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Notifications (used from Phase 6 onward)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@buscadortrabajos.local
TELEGRAM_BOT_TOKEN=

# Scraping
SCRAPER_USER_AGENT="BuscadorTrabajosBot/0.1 (+contact@example.com)"
SCRAPER_DEFAULT_DELAY_SECONDS=3
